{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/chat/session/[id]",
      "regex": "^/api/chat/session/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/chat/session/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/berita/[id]",
      "regex": "^/berita/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/berita/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/fasilitas/[id]",
      "regex": "^/fasilitas/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/fasilitas/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/jurusan/[id]",
      "regex": "^/jurusan/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/jurusan/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/konseling/[ticketId]",
      "regex": "^/konseling/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPticketId": "nxtPticketId"
      },
      "namedRegex": "^/konseling/(?<nxtPticketId>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/berita",
      "regex": "^/berita(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/berita(?:/)?$"
    },
    {
      "page": "/dashboard",
      "regex": "^/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard(?:/)?$"
    },
    {
      "page": "/fasilitas",
      "regex": "^/fasilitas(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/fasilitas(?:/)?$"
    },
    {
      "page": "/icon.png",
      "regex": "^/icon\\.png(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/icon\\.png(?:/)?$"
    },
    {
      "page": "/jurusan",
      "regex": "^/jurusan(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/jurusan(?:/)?$"
    },
    {
      "page": "/konseling",
      "regex": "^/konseling(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/konseling(?:/)?$"
    },
    {
      "page": "/prestasi",
      "regex": "^/prestasi(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/prestasi(?:/)?$"
    },
    {
      "page": "/profil",
      "regex": "^/profil(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/profil(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}